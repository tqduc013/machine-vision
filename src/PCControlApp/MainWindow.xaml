<ui:FluentWindow x:Class="PCControlApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:PCControlApp.ViewModels"
        mc:Ignorable="d"
        Title="TQD-VISION • Trạm Kiểm Định Quang Học Đai Ốc - Kỹ Sư Trần Quang Đức" 
        Height="840" Width="1360"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="#0D1117" Foreground="#E6EDF3"
        FontFamily="Segoe UI, -apple-system, Arial">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16,0,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Windows 11 TitleBar -->
            <RowDefinition Height="Auto" /> <!-- 1. Header Bar -->
            <RowDefinition Height="Auto" /> <!-- 2. Controls Toolbar -->
            <RowDefinition Height="*" />    <!-- 3. Main Workspace -->
            <RowDefinition Height="Auto" /> <!-- 4. Engineering Footer -->
        </Grid.RowDefinitions>

        <!-- 0. NATIVE WINDOWS 11 TITLEBAR -->
        <ui:TitleBar Grid.Row="0" Margin="-16,0,-16,4"
                     Title="TQD-VISION • HỆ THỐNG KIỂM ĐỊNH QUANG HỌC CHÍNH XÁC (AOI) - KEFICO SPEC" />

        <!-- 1. ENGINEERING BRANDING HEADER -->
        <ui:Card Grid.Row="1" Margin="0,0,0,10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Engineer & Station Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="8" Width="44" Height="44" Margin="0,0,12,0">
                        <TextBlock Text="TQD" Foreground="#38BDF8" FontWeight="Black" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HỆ THỐNG KIỂM ĐỊNH QUANG HỌC ĐAI ỐC CÔNG NGHIỆP" FontWeight="Bold" FontSize="16" Foreground="#F0F6FC" />
                            <ui:Badge Appearance="Success" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="IPC ONLINE 24/7" FontSize="9" FontWeight="Bold" />
                            </ui:Badge>
                        </StackPanel>
                        <TextBlock Text="Kỹ sư phát triển: Trần Quang Đức • Khoa học Máy tính (Lớp Kỹ sư Tài năng UTEHY)" FontSize="11" Foreground="#8B949E" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Station Hardware Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="TRẠM SẢN XUẤT" FontSize="8" Foreground="#8B949E" FontWeight="Bold" />
                            <TextBlock Text="LINE 01 (KEFICO-SPEC)" FontSize="11" FontWeight="Bold" Foreground="#58A6FF" />
                        </StackPanel>
                    </Border>
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="CAMERA QUANG HỌC" FontSize="8" Foreground="#8B949E" FontWeight="Bold" />
                            <TextBlock Text="Basler acA2440 (GigE Vision)" FontSize="11" FontWeight="Bold" Foreground="#3FB950" />
                        </StackPanel>
                    </Border>
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="GIAO THỨC PLC" FontSize="8" Foreground="#8B949E" FontWeight="Bold" />
                            <TextBlock Text="Socket TCP/IP :5000" FontSize="11" FontWeight="Bold" Foreground="#D29922" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 2. WORKSPACE CONTROLS TOOLBAR -->
        <ui:Card Grid.Row="2" Margin="0,0,0,10" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Method Switcher -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Phương pháp thị giác:" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ui:Button Content="{Binding ModeButtonText}" 
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon Symbol=ArrowRepeatAll24}"
                               Command="{Binding ToggleAlgorithmModeCommand}" />
                    <Border Background="#1C2128" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="10,0,0,0">
                        <TextBlock Text="{Binding CurrentModeName, StringFormat='Đang áp dụng: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#58A6FF" />
                    </Border>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="Kích hoạt chụp (Trigger)" 
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Symbol=Camera24}"
                               Margin="0,0,8,0"
                               Command="{Binding TriggerInspectionCommand}" />

                    <ui:Button Content="{Binding AutoRunButtonText}" 
                               Appearance="Success"
                               Icon="{ui:SymbolIcon Symbol=Play24}"
                               Margin="0,0,8,0"
                               Command="{Binding ToggleAutoRunCommand}" />

                    <ui:Button Content="Đặt lại bộ đếm" 
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                               Command="{Binding ResetStatsCommand}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 3. MAIN WORKSPACE (Split 60% Left / 40% Right) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Optical Camera Viewport -->
            <ui:Card Grid.Column="0" Margin="0,0,6,0" Padding="4">
                <Grid Background="#0A0C10" ClipToBounds="True">
                    <Image Source="{Binding DisplayImage}" Stretch="Uniform" />

                    <!-- Top Stream Pill -->
                    <Border Background="#CC000000" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#3FB950" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="ẢNH THỰC ĐỊA • MVTec Metal Nut • Cảm biến 2448 × 2048 px" Foreground="#C9D1D9" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Bottom Status Pill -->
                    <Border Background="#CC000000" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Góc xoay: " Foreground="#8B949E" FontSize="11" />
                            <TextBlock Text="{Binding CurrentResult.Angle, StringFormat='{}{0}°'}" Foreground="#D29922" FontSize="11" FontWeight="Bold" Margin="0,0,12,0" />
                            <TextBlock Text="Chu kỳ quét: " Foreground="#8B949E" FontSize="11" />
                            <TextBlock Text="{Binding CurrentResult.CycleTimeMs, StringFormat='{}{0:F1} ms'}" Foreground="#58A6FF" FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:Card>

            <!-- RIGHT COLUMN: Engineering Quality Dashboard -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Card 1: Verdict -->
                    <RowDefinition Height="Auto" /> <!-- Card 2: QA Data Table -->
                    <RowDefinition Height="Auto" /> <!-- Card 3: Production KPI -->
                    <RowDefinition Height="*" />    <!-- Card 4: PLC Terminal -->
                </Grid.RowDefinitions>

                <!-- Card 1: Fluent Industrial Verdict Card -->
                <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="14,12">
                    <ui:Card.Style>
                        <Style TargetType="ui:Card">
                            <Setter Property="Background" Value="#0D2818" />
                            <Setter Property="BorderBrush" Value="#238636" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentResult.IsOk}" Value="False">
                                    <Setter Property="Background" Value="#381014" />
                                    <Setter Property="BorderBrush" Value="#DA3633" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Card.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentResult.VerdictText}" FontSize="18" FontWeight="Black" Foreground="White" />
                            <TextBlock Text="{Binding CurrentResult.DefectReason, StringFormat='Chi tiết kỹ thuật: {0}'}" FontSize="12" Foreground="#F0F6FC" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentResult.SerialNumber}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Top" FontWeight="SemiBold" />
                    </Grid>
                </ui:Card>

                <!-- Card 2: Quality Inspection Data Table (Bảng đo kích thước & Dung sai) -->
                <ui:Card Grid.Row="1" Margin="0,0,0,8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="BẢNG ĐO KIỂM QUANG HỌC &amp; DUNG SAI (QC TABLE)" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,8" />

                        <!-- Table Header -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="HẠNG MỤC" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                            <TextBlock Grid.Column="1" Text="DUNG SAI" FontSize="10" FontWeight="Bold" Foreground="#8B949E" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="THỰC ĐO" FontSize="10" FontWeight="Bold" Foreground="#8B949E" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="KẾT QUẢ" FontSize="10" FontWeight="Bold" Foreground="#8B949E" HorizontalAlignment="Center" />
                        </Grid>
                        <Separator Background="#21262D" Margin="0,0,0,8" />

                        <!-- Row 1: Din -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Đường kính trong (Din)" FontSize="12" Foreground="#E6EDF3" />
                            <TextBlock Grid.Column="1" Text="140.0 - 182.0 px" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding CurrentResult.InnerDiameter, StringFormat='{}{0:F1} px'}" FontSize="12" FontWeight="Bold" Foreground="#D29922" HorizontalAlignment="Right" />
                            <ui:Badge Grid.Column="3" Appearance="Success" HorizontalAlignment="Center">
                                <TextBlock Text="ĐẠT" FontSize="9" FontWeight="Bold" />
                            </ui:Badge>
                        </Grid>

                        <!-- Row 2: Dout -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Đường kính ngoài (Dout)" FontSize="12" Foreground="#E6EDF3" />
                            <TextBlock Grid.Column="1" Text="605.0 - 658.0 px" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding CurrentResult.OuterDiameter, StringFormat='{}{0:F1} px'}" FontSize="12" FontWeight="Bold" Foreground="#D29922" HorizontalAlignment="Right" />
                            <ui:Badge Grid.Column="3" Appearance="Success" HorizontalAlignment="Center">
                                <TextBlock Text="ĐẠT" FontSize="9" FontWeight="Bold" />
                            </ui:Badge>
                        </Grid>

                        <!-- Row 3: Anomaly Score -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Điểm bất thường AI" FontSize="12" Foreground="#E6EDF3" />
                            <TextBlock Grid.Column="1" Text="&lt; 0.645" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding CurrentResult.AnomalyScore, StringFormat='{}{0:F3}'}" FontSize="12" FontWeight="Bold" Foreground="#F85149" HorizontalAlignment="Right" />
                            <ui:Badge Grid.Column="3" Appearance="Info" HorizontalAlignment="Center">
                                <TextBlock Text="GIÁM SÁT" FontSize="9" FontWeight="Bold" />
                            </ui:Badge>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Card 3: Production Yield Counters (4 Tiles) -->
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Margin="0,0,3,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="TỔNG SẢN PHẨM" FontSize="9" Foreground="#8B949E" FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalCount}" FontSize="18" FontWeight="Black" Foreground="White" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="1" Margin="3,0,3,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="TỶ LỆ ĐẠT (YIELD)" FontSize="9" Foreground="#8B949E" FontWeight="Bold" />
                            <TextBlock Text="{Binding YieldRate}" FontSize="18" FontWeight="Black" Foreground="{Binding YieldRateColor}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="2" Margin="3,0,3,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="HÀNG ĐẠT (OK)" FontSize="9" Foreground="#3FB950" FontWeight="Bold" />
                            <TextBlock Text="{Binding OkCount}" FontSize="18" FontWeight="Black" Foreground="#3FB950" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="3" Margin="3,0,0,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="HÀNG LỖI (NG)" FontSize="9" Foreground="#F85149" FontWeight="Bold" />
                            <TextBlock Text="{Binding NgCount}" FontSize="18" FontWeight="Black" Foreground="#F85149" />
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <!-- Card 4: Industrial PLC Communication Log -->
                <ui:Card Grid.Row="3" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="NHẬT KÝ BẮT TAY PLC (SOCKET TCP/IP :5000)" FontSize="11" FontWeight="Bold" Foreground="#8B949E" />
                            <TextBlock Text="• TÍN HIỆU: Y0 (PASS) / Y1 (LOẠI BỎ)" FontSize="10" Foreground="#6E7681" Margin="12,0,0,0" />
                        </StackPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding PlcLogs}" 
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas, monospace" FontSize="11" Foreground="#C9D1D9">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>

        <!-- 4. ENGINEERING FOOTER -->
        <Border Grid.Row="4" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bản quyền kỹ thuật: Kỹ sư Trần Quang Đức • Computer Science UTEHY • Sẵn sàng triển khai dây chuyền FDI" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="KIẾN TRÚC: C# .NET 8 WPF • WPF-UI (Windows 11 Fluent Design) • OpenCvSharp4 • OnnxRuntime" FontSize="11" Foreground="#6E7681" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
