<Window x:Class="PCControlApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PCControlApp.ViewModels"
        mc:Ignorable="d"
        Title="AOI Machine Vision PC Controller - C# .NET 8 WPF Pro" 
        Height="780" Width="1280"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#050811" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Main Body -->
            <RowDefinition Height="Auto" /> <!-- Architecture Footer -->
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,10" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0284C7" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                        <TextBlock Text="C#" Foreground="White" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AOI PC CONTROLLER" FontWeight="Black" FontSize="16" Foreground="White" />
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="8,0,8,0">
                                <TextBlock Text=".NET 8 WPF PRO" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" />
                            </Border>
                            <Border Background="#064E3B" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="● IPC ONLINE 24/7" Foreground="#34D399" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Trạm kiểm tra ngoại quan chip Apple A18 • Xử lý đa luồng OpenCvSharp" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <!-- System Info Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="CAMERA:" FontSize="8" Foreground="#64748B" />
                            <TextBlock Text="Basler acA2440 (5MP)" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="PLC PROTOCOL:" FontSize="8" Foreground="#64748B" />
                            <TextBlock Text="Modbus / Socket :5000" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN BODY GRID (7 Cols Left / 5 Cols Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Controls & Camera Feed -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Controls Bar -->
                <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,10" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="⚡ BẤM TRIGGER (C# OPENCV)" 
                                Style="{StaticResource ModernBtn}" 
                                Background="#0284C7" Margin="0,0,4,0"
                                Command="{Binding TriggerInspectionCommand}" />

                        <Button Grid.Column="1" Content="{Binding AutoRunButtonText}" 
                                Style="{StaticResource ModernBtn}" 
                                Background="#059669" Margin="4,0,4,0"
                                Command="{Binding ToggleAutoRunCommand}" />

                        <Button Grid.Column="2" Content="🔄 Reset Ca" 
                                Style="{StaticResource ModernBtn}" 
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                Command="{Binding ResetStatsCommand}" />
                    </Grid>
                </Border>

                <!-- Camera Viewport Box -->
                <Border Grid.Row="1" Background="#020617" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding DisplayImage}" Stretch="Uniform" />

                        <!-- Watermark HUD -->
                        <Border Background="#CC000000" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ALGO: 4G PIPELINE (C#)" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" Margin="0,0,8,0" />
                                <TextBlock Text="|" Foreground="#475569" Margin="0,0,8,0" />
                                <TextBlock Text="RES: 2448x2048" Foreground="#94A3B8" FontSize="10" Margin="0,0,8,0" />
                                <TextBlock Text="|" Foreground="#475569" Margin="0,0,8,0" />
                                <TextBlock Text="GÓC XOAY θ: " Foreground="#94A3B8" FontSize="10" />
                                <TextBlock Text="{Binding CurrentResult.Angle, StringFormat='{}{0}°'}" Foreground="#F59E0B" FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: Verdict & Real-Time Stats -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Verdict Box -->
                    <RowDefinition Height="Auto" /> <!-- KPI Cards -->
                    <RowDefinition Height="Auto" /> <!-- Cycle Time -->
                    <RowDefinition Height="*" />    <!-- PLC Logs -->
                </Grid.RowDefinitions>

                <!-- Big Verdict Box -->
                <Border Grid.Row="0" CornerRadius="12" BorderThickness="2" BorderBrush="{Binding CurrentResult.StatusColor}" Margin="0,0,0,8" Padding="14">
                    <Border.Background>
                        <SolidColorBrush Color="#0B132B" Opacity="0.9" />
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CurrentResult.VerdictText}" 
                                   FontSize="28" FontWeight="Black" HorizontalAlignment="Center"
                                   Foreground="{Binding CurrentResult.StatusColor}" />
                        <TextBlock Text="{Binding CurrentResult.DefectReason, StringFormat='Trạng thái: {0}'}" 
                                   FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CurrentResult.SerialNumber, StringFormat='Serial: {0}'}" 
                                   FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- KPI Cards Grid -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Total -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,4,4">
                        <StackPanel>
                            <TextBlock Text="TỔNG SỐ LƯỢNG" FontSize="9" Foreground="#94A3B8" FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Black" Foreground="White" />
                        </StackPanel>
                    </Border>

                    <!-- Yield Rate -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassCard}" Margin="4,0,0,4">
                        <StackPanel>
                            <TextBlock Text="TỶ LỆ ĐẠT (YIELD)" FontSize="9" Foreground="#94A3B8" FontWeight="Bold" />
                            <TextBlock Text="{Binding YieldRate}" FontSize="20" FontWeight="Black" Foreground="{Binding YieldRateColor}" />
                        </StackPanel>
                    </Border>

                    <!-- OK Count -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,4,4,0">
                        <StackPanel>
                            <TextBlock Text="HÀNG ĐẠT (OK)" FontSize="9" Foreground="#34D399" FontWeight="Bold" />
                            <TextBlock Text="{Binding OkCount}" FontSize="18" FontWeight="Bold" Foreground="#34D399" />
                        </StackPanel>
                    </Border>

                    <!-- NG Count -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassCard}" Margin="4,4,0,0">
                        <StackPanel>
                            <TextBlock Text="HÀNG LỖI (NG)" FontSize="9" Foreground="#F87171" FontWeight="Bold" />
                            <TextBlock Text="{Binding NgCount}" FontSize="18" FontWeight="Bold" Foreground="#F87171" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Cycle Time & Specs -->
                <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="0,0,0,8" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CYCLE TIME:" FontSize="8" Foreground="#64748B" />
                            <TextBlock Text="{Binding CurrentResult.CycleTimeMs, StringFormat='{}{0:F2} ms'}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="KÍCH THƯỚC ĐO:" FontSize="8" Foreground="#64748B" />
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#F59E0B">
                                <Run Text="{Binding CurrentResult.Width}" /> x <Run Text="{Binding CurrentResult.Height}" /> px
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PLC Handshake Log Terminal -->
                <Border Grid.Row="3" Background="#020617" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="PLC HANDSHAKE LOG (C# MULTI-THREAD)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding PlcLogs}" Background="Transparent" BorderThickness="0" Foreground="#38BDF8" FontSize="10" FontFamily="Consolas, JetBrains Mono" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. BOTTOM 4-LAYER ARCHITECTURE BANNER -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="0,10,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="1. CAMERA ACQUISITION" Foreground="#38BDF8" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="2. OPENCVSHARP 4G POOL" Foreground="#34D399" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="3. PLC SOCKET I/O" Foreground="#F59E0B" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="4. WPF MVVM UI" Foreground="#A855F7" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
